{
  "ignoreCommand": "node scripts/vercel-ignore.mjs",
  "functions": {
    "api/pet-v2/preview.ts": {
      "maxDuration": 60
    },
    "api/christmas-funnel.ts": {
      "maxDuration": 300
    },
    "api/christmas-generate.ts": {
      "maxDuration": 300
    },
    "api/christmas-generate-video.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "destination": "/api/apple-developer-merchantid-domain-association"
    },
    {
      "source": "/api/pet/funnel-event",
      "destination": "/api/pet-funnel-event"
    },
    {
      "source": "/api/pet-v2/funnel-event",
      "destination": "/api/pet-v2-funnel-event"
    },
    {
      "source": "/api/pet-v3/funnel-event",
      "destination": "/api/pet-v3-funnel-event"
    },
    {
      "source": "/api/christmas-v2/funnel-event",
      "destination": "/api/christmas-v2-funnel-event"
    },
    {
      "source": "/api/pet-v3/internal-test-status",
      "destination": "/api/pet-v3-internal-test-status"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/((?!api/|images/|assets/|\\.well-known/).*)",
      "destination": "/index.html"
    }
  ]
}
