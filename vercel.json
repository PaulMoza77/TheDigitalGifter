{
  "ignoreCommand": "node scripts/vercel-ignore.mjs",
  "crons": [
    {
      "path": "/api/pet-analytics-cron",
      "schedule": "0 */6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/((?!api/|images/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}