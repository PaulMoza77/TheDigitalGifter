# Public (Vercel / Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only. Never prefix with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Release control. Leave unset/false until the live test checklist is done.
CHECKOUT_ENABLED=false
ENABLE_PRODUCTION_DEPLOY=0

# Required and distinct. Do not reuse FULFILLMENT_SECRET as the access-token key.
ACCESS_TOKEN_SECRET=
FULFILLMENT_SECRET=

# Public origin used to build Stripe success/cancel URLs and result emails.
# Never accept success_url / cancel_url from the client.
SITE_URL=https://www.thedigitalgifter.com
ALLOWED_APP_ORIGINS=https://www.thedigitalgifter.com

# Scheduler (Supabase Dashboard → Edge Functions → Schedules)
# process-fulfillment-jobs: * * * * *
# purge-expired-media: 15 * * * *
# Required header on both: x-fulfillment-secret=$FULFILLMENT_SECRET
# (Authorization: Bearer $SUPABASE_SERVICE_ROLE_KEY is also accepted.)
# Cron is the recovery mechanism. kickFulfillmentWorker is waitUntil-only.

# Stripe (use test keys until live checkout is approved)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STILL_IMAGE=

# Generation
REPLICATE_API_TOKEN=
REPLICATE_NANO_BANANA_MODEL=google/nano-banana

# Email (optional until launch)
RESEND_API_KEY=
RESULT_EMAIL_FROM=TheDigitalGifter <support@thedigitalgifter.com>
