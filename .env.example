# Public (Vercel / Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only. Never prefix with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Release control. Leave unset/false until the live test checklist is done.
# Production Vercel must never set CHECKOUT_ENABLED, VITE_CHECKOUT_ENABLED,
# VITE_STRIPE_TEST_MODE, or ALLOW_STAGING_CHECKOUT.
CHECKOUT_ENABLED=false
ENABLE_PRODUCTION_DEPLOY=0

# Staging / protected Vercel Preview only (never Production):
# VITE_CHECKOUT_ENABLED=true
# VITE_STRIPE_TEST_MODE=true
# ALLOW_STAGING_CHECKOUT=true
# STRIPE_SECRET_KEY must be sk_test_... or checkout stays off.

# Required and distinct. Do not reuse FULFILLMENT_SECRET as the access-token key.
ACCESS_TOKEN_SECRET=
FULFILLMENT_SECRET=

# Public origin used to build Stripe success/cancel URLs and result emails.
# Never accept success_url / cancel_url from the client.
SITE_URL=https://www.thedigitalgifter.com
ALLOWED_APP_ORIGINS=https://www.thedigitalgifter.com

# Official scheduler (pg_cron + Vault names, no secrets in Git):
#   supabase/migrations/20260817_fulfillment_schedules.sql
#   docs/fulfillment-schedules.md
# config.toml comments are not a scheduler.
# Post-deploy: SUPABASE_DB_URL=... npm run verify:schedules

# Stripe (use test keys until live checkout is approved)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STILL_IMAGE=

# Generation
REPLICATE_API_TOKEN=
REPLICATE_NANO_BANANA_MODEL=google/nano-banana

# Email is required at launch. result_emailed_at is set only after Resend
# returns HTTP success. Failures enqueue a result_email fulfillment retry.
RESEND_API_KEY=
RESULT_EMAIL_FROM=TheDigitalGifter <support@thedigitalgifter.com>
