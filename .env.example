# Local only — never commit secrets
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only (VPS origin / API routes). Never prefix with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Pet fulfillment gate (/api/pet-provider-status):
#   PET_FULFILLMENT_ENABLED=true   # set false/off to pause paid intake
# Paid generation uses REPLICATE_API_TOKEN on Supabase Edge — it is NOT required
# on the VPS origin for checkout to stay open. If present on the origin, the probe also checks
# live Replicate credit/auth; if absent, the probe stays open after kill-switch
# and recent billing-hold checks (reason: probe_token_absent).
#   REPLICATE_API_TOKEN=           # optional on the VPS origin; keep on Supabase Edge

# Pet funnel Stripe (Supabase Edge Function secret). Publishable key is safe to
# return to the browser for embedded Checkout / Apple Pay.
#   STRIPE_PUBLISHABLE_KEY=pk_live_...
#   STRIPE_SECRET_KEY=sk_live_...
#
# Apple Pay on www.thedigitalgifter.com (VPS secrets/app.env only — never VITE_):
#   1. Stripe Dashboard → Settings → Payment methods → Apple Pay → Configure domains
#   2. Add thedigitalgifter.com and download the verification file
#   3. Set STRIPE_APPLE_PAY_DOMAIN_ASSOCIATION to the exact file contents (single line)
#   4. Redeploy the VPS origin; verify:
#        curl -sSI https://www.thedigitalgifter.com/.well-known/apple-developer-merchantid-domain-association
#      must return HTTP 200 (not 503 / HTML)
#   STRIPE_APPLE_PAY_DOMAIN_ASSOCIATION=

# Meta CAPI: set META_PIXEL_ID and META_CAPI_ACCESS_TOKEN as Supabase Edge Function
# secrets only. Do not put those values in this file or in VITE_ variables.

# ---------------------------------------------------------------------------
# Pet hybrid analytics (Supabase Edge Function secrets + optional VPS cron)
# Never prefix these with VITE_. Never ship them to the browser.
# ---------------------------------------------------------------------------
#
# Christmas checkout (disabled by default — foundation only):
#   CHRISTMAS_CHECKOUT_ENABLED=true
#   CHRISTMAS_PLANNER_CHECKOUT_ENABLED=true  # planner charges; seed checkout_live=false until enabled
#   Uses the same STRIPE_SECRET_KEY / STRIPE_PUBLISHABLE_KEY as pet checkout.
#   Packages must be purchasable with price_cents > 0 in christmas_packages.
# Christmas Advent / free gift (Supabase Edge secrets; keep off in production):
#   CHRISTMAS_ADVENT_ENABLED=false
#   CHRISTMAS_ADVENT_CREDITS_ENABLED=false
#   CHRISTMAS_FREE_GIFT_ENABLED=false
#   CHRISTMAS_TEST_BYPASS=false          # required before client __test_force is honored
# Christmas generation:
#   CHRISTMAS_GENERATION_ENABLED=true   # default true when unset
#   CHRISTMAS_GENERATION_MOCK=true      # pipeline proof without Replicate
#   CHRISTMAS_IMAGE_MODEL=black-forest-labs/flux-kontext-pro
#   CHRISTMAS_EMAIL_FROM=...            # optional; falls back to TRANSACTIONAL_EMAIL_FROM
#
# Santa Voice Call (AI realtime — never VITE_):
#   CHRISTMAS_SANTA_CALL_ENABLED=true          # kill switch; false disables start/mint
#   CHRISTMAS_SANTA_CALL_PROVIDER=openai_realtime  # or elevenlabs_agents
#   CHRISTMAS_SANTA_CALL_OPENAI_MODEL=gpt-realtime
#   CHRISTMAS_SANTA_CALL_OPENAI_VOICE=ash
#   CHRISTMAS_SANTA_CALL_TTL_DAYS=30
#   CHRISTMAS_SANTA_CALL_ELEVENLABS_AGENT_ID=   # optional alternate provider
#   ELEVENLABS_API_KEY=                        # optional; OPENAI_API_KEY reused from Clip/Santa TTS
#   # Live sell also requires christmas_santa_voice_call in CHRISTMAS_LIVE_PRODUCTS
#   # Landing page release gate (Vite):
#   VITE_SANTA_CALL_LANDING_PUBLIC=false       # true only after commercial launch approval
#   VITE_SANTA_CALL_PREVIEW_TOKEN=             # optional ≥16 chars; ?preview=<token> unlocks gated landing
#   VITE_SANTA_CALL_ENABLE_CHECKOUT=false      # commercial checkout UI (requires LIVE_PRODUCTS)
#   VITE_SANTA_CALL_QA_CHECKOUT=false          # parent TEST QA overlay only
#   CHRISTMAS_SANTA_CALL_QA_PAGE_TOKEN=        # ≥16 chars; gates /_qa/santa-qa HTML + parent TEST checkout
#   CHRISTMAS_SANTA_CALL_QA_PAGE_EXPIRES_AT=   # ISO-8601 expiry for page token
#   CHRISTMAS_SANTA_CALL_QA_CALL_ORIGIN=https://www.thedigitalgifter.com/_qa/santa-qa
#   # Private QA overlay builds may set LANDING_PUBLIC=true under /_qa/santa-private only
#

# Meta Ads Insights (separate from CAPI — needs ads_read):
#   META_AD_ACCOUNT_ID=1234567890          # with or without act_ prefix
#   META_ADS_ACCESS_TOKEN=...              # System User / user token with ads_read
#   PET_ADS_SYNC_START_DATE=2026-08-16     # optional backfill floor
#   PET_META_CAMPAIGN_IDS=120253346791240170  # optional extra/override IDs (comma-separated).
#                                          # Primary allowlist is public.pet_meta_campaign_allowlist.
#                                          # Add future TDG Cat/Other campaign IDs before they spend.
#
# GA4 Data API (Measurement ID G-YF2GRM2TL4 alone is NOT enough):
#   GA4_PROPERTY_ID=123456789             # numeric property id from GA4 Admin
#   GA4_SERVICE_ACCOUNT_EMAIL=...@....iam.gserviceaccount.com
#   GA4_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#   # OR instead of email+key:
#   GA4_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
#
# Grant the service account "Viewer" on the GA4 property.
#
# Cron (VPS or Supabase schedule):
#   PET_ANALYTICS_CRON_SECRET=...          # also acceptable as CRON_SECRET
#   Call POST /api/pet-analytics-cron every few hours from the VPS scheduler
#
# Pet funnel internal / founder traffic exclusion (server-only, never VITE_):
#   PET_FUNNEL_INTERNAL_COUNTRY_CODES=RO,IT   # ISO codes from cf-ipcountry / x-country-code
#   PET_FUNNEL_TEST_UTM_SOURCES=internal,audit_smoke,ctrl_test
#   PET_FUNNEL_TEST_UTM_CAMPAIGNS=cat-v3-live-smoke,checkout-proof
#   PET_FUNNEL_TEST_IP_HOSTMARKERS=rentalcarsoradea,rdsnet
#   PET_FUNNEL_TEST_HOSTNAME_TLDS=ro,it
#   PET_FUNNEL_TEST_IPS=                     # optional exact client IPs
#
# Social publisher (Supabase Edge secrets — never VITE_):
#   SOCIAL_TOKEN_ENCRYPTION_KEY=            # 32+ chars; falls back to PET_TOKEN_ENCRYPTION_KEY
#   SOCIAL_OAUTH_REDIRECT_URL=              # defaults to <SUPABASE_URL>/functions/v1/social-publisher
#   SOCIAL_PUBLISHER_PUBLIC_BASE_URL=https://www.thedigitalgifter.com
#   SOCIAL_PUBLISHER_CRON_SECRET=           # also acceptable: CRON_SECRET
#   SOCIAL_PUBLISHER_ALLOW_LIVE_POSTS=false # keep false until explicitly authorized
#   META_APP_ID=
#   META_APP_SECRET=
#   TIKTOK_CLIENT_KEY=
#   TIKTOK_CLIENT_SECRET=
#   YOUTUBE_CLIENT_ID=                      # or GOOGLE_OAUTH_CLIENT_ID
#   YOUTUBE_CLIENT_SECRET=
#
# AI Clip Factory (origin / VPS — ffmpeg + Whisper/GPT). Never prefix with VITE_.
#   OPENAI_API_KEY=                 # Whisper transcription + moment analysis
#   CLIP_FACTORY_CRON_SECRET=       # optional; falls back to CRON_SECRET
#   CLIP_FACTORY_SIGNING_SECRET=    # optional HMAC for playback URLs
#   CLIP_FACTORY_FONT=              # optional TTF path for burned-in captions
#   YOUTUBE_API_KEY=                # optional YouTube Data API key for title/duration/privacy ONLY (cannot download MP4)
#   CLIP_INGEST_PROVIDER=auto       # auto | authorized_http | ytdlp | direct
#   CLIP_INGEST_ENDPOINT=           # authorized importer URL (alias of CLIP_FACTORY_YOUTUBE_IMPORT_URL)
#   CLIP_INGEST_API_KEY=            # Bearer token for CLIP_INGEST_ENDPOINT (alias of CLIP_FACTORY_YOUTUBE_IMPORT_SECRET)
#   CLIP_INGEST_FALLBACK_PROVIDER=ytdlp
#   CLIP_FACTORY_YOUTUBE_IMPORT_URL=  # HTTP importer that returns a direct MP4 URL (see providers.ts). Empty in production today.
#   CLIP_FACTORY_YOUTUBE_IMPORT_SECRET=  # Bearer token sent to that importer
#   CLIP_FACTORY_DISABLE_YTDLP=1    # set to skip server-side yt-dlp (YouTube then requires upload)
#   CLIP_FACTORY_IMPORT_WORKER_TOKEN= # bearer for the Mac import worker; store the same value in Keychain, never in git
#   CLIP_FACTORY_YTDLP_BIN=         # optional path to yt-dlp
#   VIMEO_ACCESS_TOKEN=             # official Vimeo download when the video permits it
#
# Gift Concierge live products (Supabase Edge secrets only — never VITE_):
#   AFFILIATE_PRODUCT_SEARCH_ENABLED=false
#   EBAY_PRODUCTION_ACCESS=false
#   EBAY_CLIENT_ID=
#   EBAY_CLIENT_SECRET=
#   EBAY_EPN_CAMPAIGN_ID=
# Leave the flag off until official eBay Browse / EPN production access is verified.

