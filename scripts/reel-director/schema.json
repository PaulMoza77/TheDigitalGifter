{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tdg-reel-director-manifest",
  "title": "TDG Reel Director generation manifest",
  "type": "object",
  "required": [
    "project",
    "status",
    "pipeline",
    "characters",
    "reference_assets",
    "shots",
    "audio",
    "assembly",
    "cost_estimate"
  ],
  "properties": {
    "project": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "READY_FOR_APPROVAL",
        "APPROVED",
        "GENERATING",
        "ASSEMBLED",
        "QA",
        "LIBRARY",
        "BLOCKED"
      ]
    },
    "pipeline": {
      "type": "array",
      "minItems": 8,
      "items": { "type": "string" }
    },
    "characters": { "type": "object" },
    "reference_assets": { "type": "array", "minItems": 1 },
    "shots": { "type": "array", "minItems": 1 },
    "audio": { "type": "object" },
    "assembly": { "type": "object" },
    "cost_estimate": { "type": "object" }
  }
}
