      {
        "id": "s1",
        "text": "This is Lauren. She loves Christmas. But it\u2019s too much.",
        "start": 0.4,
        "speech_duration": 4.437,
        "end": 4.837,
        "latest_end": 4.95,
        "window_slack_s": 0.113
      },
      {
        "id": "s2",
        "text": "Gifts, dinner, family\u2026 she has to remember all of it.",
        "start": 5.4,
